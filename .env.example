# Copiar a infra/.env (al lado del docker-compose.yml) y completar. El .env NO se commitea.
# Tiene que estar en infra/: `docker compose -f infra/docker-compose.yml` lee el .env de
# la carpeta del compose, no el de la raiz del repositorio.
DB_PASSWORD=budgetwise_dev
JWT_SECRET=una-clave-larga-y-aleatoria-para-firmar-los-tokens
# Opcional: clave de Gemini para las recomendaciones con IA (D-12). Si falta, el endpoint
# usa el respaldo por reglas. Se crea gratis en Google AI Studio (aistudio.google.com).
# Capa gratuita: Google puede leer lo que se envia. Usar solo datos de prueba.
GEMINI_API_KEY=
